NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://amisos:amisos@localhost:5432/amisos_b2b
CORS_ORIGIN=http://localhost:5173
# Arayüzün kök adresi (şifre sıfırlama / e-posta doğrulama bağlantıları)
APP_URL=http://localhost:5173
# Giriş ve şifre sıfırlama uçlarında IP başına dakikadaki istek sınırı
AUTH_RATE_LIMIT_PER_MINUTE=5
# Ters vekil (nginx, yük dengeleyici) arkasında: atlama sayısı (1) veya IP/CIDR listesi.
# Boş = kapalı; X-Forwarded-For dikkate alınmaz. "true" kabul edilmez.
TRUST_PROXY=
