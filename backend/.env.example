NODE_ENV=development
PORT=3100
DATABASE_URL=postgres://amisos:amisos@localhost:5433/amisos_b2b
CORS_ORIGIN=http://localhost:5180
# Arayüzün kök adresi (şifre sıfırlama / e-posta doğrulama bağlantıları)
APP_URL=http://localhost:5180
# Gönderen adres (K-56)
MAIL_FROM=Amisos B2B <onay@amisosb2b.com>
# Giriş ve şifre sıfırlama uçlarında IP başına dakikadaki istek sınırı
AUTH_RATE_LIMIT_PER_MINUTE=5
# Ters vekil (nginx, yük dengeleyici) arkasında: atlama sayısı (1) veya IP/CIDR listesi.
# Boş = kapalı; X-Forwarded-For dikkate alınmaz. "true" kabul edilmez.
TRUST_PROXY=

# Görsel kütüphanesi dizini (K-61, K-62); göreli yol backend çalışma dizinine göredir. Git dışıdır.
MEDIA_DIR=storage/media
